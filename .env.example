#copy to .env before the first `docker compose up`.
#every value has a working default, so .env is optional for local runs.

#port the app is served on: http://localhost:8080
APP_PORT=8080

#Django
DJANGO_SECRET_KEY=change-me-for-anything-public
DJANGO_DEBUG=0
#"*" lets teammates open the app from a phone on the same Wi-Fi (http://<your-ip>:8080).
#set real host names before any public deployment.
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

#moderation admin account, created on first start (local only).
DJANGO_SUPERUSER_USERNAME=moderator
DJANGO_SUPERUSER_PASSWORD=lights-out-local
DJANGO_SUPERUSER_EMAIL=moderator@example.com

#Postgres
POSTGRES_DB=lightsout
POSTGRES_USER=lightsout
POSTGRES_PASSWORD=lightsout

#load 200 starter cards and the 60-question prompt bank on an empty database.
LOAD_SEED=1

#feature 1 limits
CARD_RATE_LIMIT_PER_HOUR=5

#feature 5: auto-hide a card for manual review after this many reports.
REPORTS_BEFORE_REVIEW=3
REMOVED_CARD_RETENTION_DAYS=30

#moderation classifier. "keyword" is the built-in heuristic.
#TODO(moderation): plug in a trained classifier (see docs/moderation-policy.md).
MODERATION_CLASSIFIER=keyword
